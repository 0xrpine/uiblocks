{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": {
      "@/components/*": ["./apps/docs/src/components/*"],
      "@/lib/*": ["./apps/docs/src/lib/*"]
    }
  },
  "include": [
    "src/registry/**/*.tsx",
    "tests/visual/**/*.ts"
  ],
  "exclude": ["node_modules", "apps/docs/.next"]
}
